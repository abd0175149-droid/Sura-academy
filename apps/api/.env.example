# Sura Academy API — local development template.
# Values match infra/docker/compose.yaml (dev-only placeholders, not secrets).
# Copy to .env (git-ignored) and run `php artisan key:generate`.

APP_NAME="Sura Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:28000

# Instants are UTC (constitution Art. 6); config/app.php pins timezone to UTC.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: the migrator role owns the schema. Runtime role sura_app is wired in WP-1.8.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=25432
DB_DATABASE=sura
DB_USERNAME=sura_migrator
DB_PASSWORD=sura-dev-migrator

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=sura_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=sura-cache-

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=sura-dev-redis
REDIS_PORT=26379
REDIS_PREFIX=sura-

# Mailpit (UI on http://localhost:28025). Never port 25.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=21025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sura.local"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (S3-compatible; console on http://localhost:29001)
AWS_ACCESS_KEY_ID=sura-dev
AWS_SECRET_ACCESS_KEY=sura-dev-minio
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=sura-local
AWS_ENDPOINT=http://127.0.0.1:29000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Optional services (compose profiles `pdf` and `scan`)
GOTENBERG_URL=http://127.0.0.1:23000
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=23310

# Error tracking: no DSN until WP-5.5
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
