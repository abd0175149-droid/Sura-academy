# WP-0.4 video spike — provider keys. Copy this file to `.env` in the same folder (VS Code:
# right-click → Copy, then Paste and rename) and fill the values. `.env` is git-ignored.
# Never paste these values into chat, GitHub or a commit.

# LiveKit Cloud → your project (data region: European Union, Frankfurt) → Settings → API Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Zoom Video SDK (Zoom Build Platform) → Video SDK app → SDK credentials
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
# Same Video SDK app → Event subscriptions → Secret Token (signs join/leave/recording webhooks)
ZOOM_WEBHOOK_SECRET=

# Optional: a join window in ISO-8601 UTC (CLS-02 probe). Empty = always open.
SPIKE_WINDOW_OPENS_AT=
SPIKE_WINDOW_CLOSES_AT=
